use context starter2024
#a
fun calc1(x :: Number)-> Number:
  ((x + 2) / 2) - (2 * x)
end

#b
fun calc2(x :: Number)-> Number:
  144 - ((x * x) + x)
end

#c
fun calc3(x :: Number)-> Number:
  (num-sqrt(x) - (2 * x)) + 12
end

#d
fun calc4(x :: Number)-> Number:
  num-expt(x, 3) - ((x / 4) + num-expt(x, -1))
end

#e
fun calc5(x :: Number)-> Number:
  (2 * (num-sqrt(x + 5))) - 26
end

#f
fun calc6(x :: Number)-> Number:
  (x * (x + 3)) - 4
end

